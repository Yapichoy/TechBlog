extends layouts/main.layout.pug

block title
  title=Users

block content
  div.content-wrapper
    <!-- Main content -->
    section.content
      form(method="POST", action="/admin/post/add", enctype='multipart/form-data')
        div.row
          div.col-md-12
            div.card.card-primary
              div.card-header
                h3.card-title="Add Post"
                div.card-tools
                  button.btn.btn-tool(type="button", data-card-widget="collapse", title="Collapse")
                    i.fas.fa-minus

              div.card-body
                div.form-group
                  label(for="title")=Title
                  input#title.form-control(type="text", name="title")
                div.form-group
                  label(for="description")=Description
                  textarea#description.form-control(name="description")
                div.form-group
                  label(for="preview")=Preview
                  input#preview.form-control(type="file", name="preview")
                div.form-group
                  label(for="metas")=Meta
                  select#metas.form-control(name="metas", multiple) 
                    each meta in metas
                      option(value=meta.id, )= meta.name
                div.form-group
                  label(for="text")=Body
                  textarea#text.form-control(name="text")
                div.form-group
                  label=Status
                  select.form-control#status(name="status")
                    option(value="1")="Active"
                    option(value="2")="Inactive"
                    option(value="3", selected)="Draft"
                    option(value="4")="Deleted"

        div.row
          div.col-12
            a.btn.btn-secondary(href="#")="Cancel"
            input.btn.btn-success.float-right(type="submit", value="Add New Post")

block scripts 
  script(src="/admin/js/post.add.js")
